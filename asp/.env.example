PORT=4000
# Exact website origin(s), comma separated. Only needed if the site and API are on different domains.
CORS_ORIGINS=http://localhost:4000
# Owner WhatsApp number for the "Send Enquiry on WhatsApp" button: digits only, country code first, no "+" or spaces.
# Example format: 91XXXXXXXXXX. Replace this placeholder with the real number.
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
